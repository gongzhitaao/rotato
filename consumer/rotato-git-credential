#!/usr/bin/env bash
# rotato-git-credential <secret-uuid> <get|store|erase>
#
# A git credential helper: on `get`, emits the current PAT fetched from
# Bitwarden. store/erase are no-ops — the PAT lives in Bitwarden, not on disk.
#
# Configure (install.sh does this for you):
#   [credential "https://gitlab.com"]
#       username = <user>
#       helper = "!rotato-git-credential <secret-uuid>"
set -euo pipefail

secret_id="${1:?usage: rotato-git-credential <secret-uuid> <get|store|erase>}"
op="${2:-}"

# git only needs a value on `get`; nothing to persist or clear otherwise.
[ "$op" = "get" ] || exit 0

here="$(dirname "$(readlink -f "$0")")"
printf 'password=%s\n' "$("$here/rotato-fetch" "$secret_id")"
