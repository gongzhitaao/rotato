#!/usr/bin/env bash
# rotato-git-credential [--github] <secret-uuid> <get|store|erase>
#
# A git credential helper. On `get` it emits the current credential; store and
# erase are no-ops — nothing lives on disk.
#
# Default mode: <secret-uuid> is a token in Bitwarden (e.g. a GitLab PAT); emit
# it as the password.
#
# --github mode: <secret-uuid> is a GitHub App private key (PEM) in Bitwarden;
# mint a short-lived installation token from it and emit it with the required
# username x-access-token. ROTATO_GH_APP_ID and ROTATO_GH_INSTALLATION_ID must
# be set (install.sh embeds them in the helper command).
#
# Configure (install.sh does this for you):
#   [credential "https://gitlab.com"]
#       username = <user>
#       helper = "!rotato-git-credential <secret-uuid>"
#   [credential "https://github.com"]
#       helper = "!ROTATO_GH_APP_ID=.. ROTATO_GH_INSTALLATION_ID=.. rotato-git-credential --github <pem-uuid>"
set -euo pipefail

mode="secret"
if [ "${1:-}" = "--github" ]; then mode="github"; shift; fi

secret_id="${1:?usage: rotato-git-credential [--github] <secret-uuid> <get|store|erase>}"
op="${2:-}"

# git only needs a value on `get`; nothing to persist or clear otherwise.
[ "$op" = "get" ] || exit 0

here="$(dirname "$(readlink -f "$0")")"

if [ "$mode" = "github" ]; then
  # Installation tokens require the username x-access-token.
  printf 'username=x-access-token\n'
  printf 'password=%s\n' "$("$here/rotato-github-token" "$secret_id")"
else
  printf 'password=%s\n' "$("$here/rotato-fetch" "$secret_id")"
fi
