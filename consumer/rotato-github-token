#!/usr/bin/env bash
# rotato-github-token <pem-secret-uuid>
#
# Mint a short-lived GitHub App installation access token (~1h) and print it.
# Reads the App private key (PEM) from Bitwarden via rotato-fetch, signs a
# short-lived RS256 JWT, and exchanges it for the installation token. The PEM
# stays in memory and on /dev/fd — it is never written to disk.
#
# Config via env (not secret; install.sh embeds these in the helper command):
#   ROTATO_GH_APP_ID           App ID (number) or Client ID (string) -> JWT iss
#   ROTATO_GH_INSTALLATION_ID  installation to mint the token for
#   GITHUB_API                 API base (default https://api.github.com)
#
# Deps: bash, openssl, curl, jq (plus bws + jq via rotato-fetch).
set -euo pipefail

pem_secret_id="${1:?usage: rotato-github-token <pem-secret-uuid>}"
app_id="${ROTATO_GH_APP_ID:?rotato-github-token: ROTATO_GH_APP_ID not set}"
installation_id="${ROTATO_GH_INSTALLATION_ID:?rotato-github-token: ROTATO_GH_INSTALLATION_ID not set}"
api="${GITHUB_API:-https://api.github.com}"

here="$(dirname "$(readlink -f "$0")")"
pem="$("$here/rotato-fetch" "$pem_secret_id")"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# JWT: iat backdated 60s for clock skew, exp +9min (GitHub caps at 10). iss is
# emitted unquoted when it's a numeric App ID, quoted for a string Client ID.
now="$(date +%s)"
iat="$((now - 60))"
exp="$((now + 540))"
if [[ "$app_id" =~ ^[0-9]+$ ]]; then iss="$app_id"; else iss="\"$app_id\""; fi
header='{"alg":"RS256","typ":"JWT"}'
payload="$(printf '{"iat":%d,"exp":%d,"iss":%s}' "$iat" "$exp" "$iss")"

signing_input="$(printf '%s' "$header" | b64url).$(printf '%s' "$payload" | b64url)"
signature="$(printf '%s' "$signing_input" \
  | openssl dgst -sha256 -sign <(printf '%s' "$pem") -binary | b64url)"
jwt="$signing_input.$signature"

curl -fsS -X POST \
  -H "Authorization: Bearer $jwt" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "$api/app/installations/$installation_id/access_tokens" \
  | jq -r '.token'
