#!/usr/bin/env bash
# rotato-fetch <secret-uuid>
#
# Print a secret's current value from Bitwarden Secrets Manager, read-only.
# Authenticates with this machine's token (a read-only machine account) read
# from $ROTATO_TOKEN_FILE (default ~/.config/rotato/token).
#
# This is the primitive every consumer uses: git via rotato-git-credential,
# anything else (env vars, app config, systemd units) by calling it directly.
set -euo pipefail

secret_id="${1:?usage: rotato-fetch <secret-uuid>}"
token_file="${ROTATO_TOKEN_FILE:-$HOME/.config/rotato/token}"

[ -r "$token_file" ] || {
  echo "rotato-fetch: cannot read token file: $token_file" >&2
  exit 1
}

BWS_ACCESS_TOKEN="$(cat "$token_file")" \
  bws secret get "$secret_id" | jq -r '.value'
