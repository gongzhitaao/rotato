#!/usr/bin/env bash
# Test stub for the bws CLI. Models a single secret's value in $BWS_STORE.
#   bws secret get  <id>              -> prints {"value":"<store>"}
#   bws secret edit <id> --value <v>  -> writes <v> to the store
# Set BWS_STUB_READONLY=1 to make `edit` a silent no-op (simulates a write that
# does not persist, for testing the write-back verify path).
set -euo pipefail
store="${BWS_STORE:?BWS_STORE not set}"

case "${1:-} ${2:-}" in
  "secret get")
    printf '{"value":"%s"}\n' "$(cat "$store" 2>/dev/null || true)"
    ;;
  "secret edit")
    [ "${BWS_STUB_READONLY:-0}" = "1" ] && exit 0
    shift 2
    while [ $# -gt 0 ]; do
      [ "$1" = "--value" ] && { printf '%s' "$2" >"$store"; break; }
      shift
    done
    ;;
  *)
    echo "bws stub: unexpected args: $*" >&2
    exit 2
    ;;
esac
