# Copy to gitlab-pat.env and edit. *.env here is gitignored.
ROTATOR="gitlab-pat"
SCHEDULE="0 3 */14 * *"          # every 14 days at 03:00
TIME_ZONE="America/New_York"

# --- rotator-specific ---
GITLAB_PAT_SECRET_ID="REPLACE_WITH_BWS_SECRET_UUID"
GITLAB_HOST="https://gitlab.com"
EXPIRY_DAYS="30"

# Which of the above vars to inject into the Cloud Run job's environment.
ROTATOR_ENV=(GITLAB_PAT_SECRET_ID GITLAB_HOST EXPIRY_DAYS)
