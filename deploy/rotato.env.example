# rotato — fill in and run. Copy to rotato.env (gitignored), edit, then:
#
#   deploy/run.sh                 # = setup + deploy-rotator + add-alert
#
# The ONLY secret in this file is BWS_ACCESS_TOKEN, and it is needed only to
# BOOTSTRAP: setup.sh uploads it to GCP Secret Manager, after which the Cloud
# Run job reads it from there. You can blank it again once setup has run.

# ── GCP target ──
PROJECT_ID="your-gcp-project-id"
PROJECT_NUMBER="000000000000"
REGION="us-central1"
REPO="rotato"                    # Artifact Registry repo
IMAGE_NAME="rotato"

# ── Bootstrap secret: rotator machine account, read+write ──
BWS_ACCESS_TOKEN=""

# ── Rotation job ──
# One job rotates EVERY secret tagged `#rotato=<type>` in this Bitwarden org.
# Per-secret config (host, expiry, cadence) lives in each secret's note tags,
# not here, so adding a secret to rotation needs no redeploy. See `list tags`.
BWS_ORGANIZATION_ID="REPLACE_WITH_BWS_ORGANIZATION_UUID"
SCHEDULE="0 3 * * *"             # daily at 03:00 (rotates every tagged secret)
TIME_ZONE="America/New_York"
STALE_AFTER_DAYS="21"            # default; a secret may override with #cadence

# ── Alerting (optional; blank to skip) ──
# Email notified on: a failed run, and a STALE secret (its value older than its
# cadence, i.e. rotation silently failing). Without it a failure is silent until
# the token actually expires.
ALERT_EMAIL=""
