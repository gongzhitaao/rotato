# rotato — fill in and run. Copy to rotato.env (gitignored), edit, then:
#
#   deploy/run.sh                 # = setup.sh + add-rotator.sh, end to end
#
# The ONLY secret in this file is BWS_ACCESS_TOKEN, and it is needed only to
# BOOTSTRAP: setup.sh uploads it to GCP Secret Manager, after which the Cloud
# Run job reads it from there. You can blank it again once setup has run.

# ── GCP target ──
PROJECT_ID="your-gcp-project-id"
PROJECT_NUMBER="000000000000"
REGION="us-central1"
REPO="rotato"                    # Artifact Registry repo
IMAGE_NAME="rotato"

# ── Bootstrap secret: rotator machine account, read+write ──
BWS_ACCESS_TOKEN=""

# ── Rotator ──
ROTATOR="gitlab-pat"
SCHEDULE="0 3 */14 * *"          # every 14 days at 03:00
TIME_ZONE="America/New_York"
GITLAB_PAT_SECRET_ID="REPLACE_WITH_BWS_SECRET_UUID"
GITLAB_HOST="https://gitlab.com"
EXPIRY_DAYS="30"
# Which vars to inject into the Cloud Run job's environment.
ROTATOR_ENV=(GITLAB_PAT_SECRET_ID GITLAB_HOST EXPIRY_DAYS)
